<?xml version="1.0" encoding="utf-8"?>
<<odoo>

    <!-- User: only see/edit/create their own patients -->
    <record id="rule_hms_user_own_patients" model="ir.rule">
        <field name="name">HMS User: Own Patients Only</field>
        <field name="model_id" ref="model_hms_patient"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('hms.group_hms_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Manager: see all patients -->
    <record id="rule_hms_manager_all_patients" model="ir.rule">
        <field name="name">HMS Manager: All Patients</field>
        <field name="model_id" ref="model_hms_patient"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hms.group_hms_manager'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>